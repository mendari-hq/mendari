{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A patient portal message",
  "type": "object",
  "additionalProperties": false,
  "required": ["message"],
  "properties": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "subject": {"type": "string", "maxLength": 200},
        "body": {"type": "string", "minLength": 1, "maxLength": 5000}
      }
    }
  }
}
