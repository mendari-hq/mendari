{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic chart summary input (test fixture)",
  "description": "Synthetic test fixture, not clinically reviewed, not for patient care: an adult patient's chart as fhir/mapping.yaml reads it from a FHIR record. `patient` is required, so a record whose Patient could not be read is refused; it takes more keys than these, for a test's own fields. `order` is filled only by the agent's order-sign twin (tests/support/chart_fixture.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["patient"],
  "properties": {
    "patient": {
      "type": "object",
      "properties": {
        "age": {"type": "integer", "minimum": 18, "maximum": 120},
        "sex": {"enum": ["female", "male", "other", "unknown"]}
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 64},
          "flag": {"type": "string", "maxLength": 64},
          "text": {"type": "string", "maxLength": 500},
          "status": {"type": "string", "maxLength": 64},
          "onset": {"type": "string", "maxLength": 64}
        }
      }
    },
    "medications": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 64},
          "name": {"type": "string", "maxLength": 500},
          "status": {"type": "string", "maxLength": 64},
          "start": {"type": "string", "maxLength": 64},
          "end": {"type": "string", "maxLength": 64}
        }
      }
    },
    "problems": {"type": "string", "minLength": 1, "maxLength": 20000},
    "notes": {"type": "string", "minLength": 1, "maxLength": 20000},
    "order": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64},
        "text": {"type": "string", "maxLength": 500},
        "priority": {"enum": ["routine", "urgent", "asap", "stat"]}
      }
    }
  }
}
