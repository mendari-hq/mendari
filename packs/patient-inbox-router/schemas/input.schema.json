{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhealth.dev/packs/openhealth/patient-inbox-router/input.schema.json",
  "title": "Patient inbox message",
  "description": "One message from a patient (or caregiver) to the practice. Carries no direct identifiers.",
  "type": "object",
  "required": ["message"],
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "object",
      "required": ["body"],
      "additionalProperties": false,
      "properties": {
        "subject": {"type": "string", "maxLength": 300},
        "body": {"type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S"},
        "channel": {"enum": ["portal", "sms", "email"]},
        "sent_at": {"type": "string", "format": "date-time"}
      }
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "age_band": {"enum": ["0-17", "18-39", "40-64", "65+"]},
        "preferred_language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"}
      }
    }
  }
}
