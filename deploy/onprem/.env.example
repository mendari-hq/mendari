# Copy to .env and fill in. Never commit the filled-in file. Every setting is explained in
# docs/deploying-with-phi.md.
# A release image (ghcr.io/mendari-hq/mendari-engine:<tag>, or one agent's image), or one you
# built: docker build --build-arg AGENT=mendari/portal-message-agent -t mendari-agent .
# Pin a pulled image by digest (<image>:<tag>@sha256:<digest>; `docker buildx imagetools inspect`
# shows it), so a re-pushed tag never changes what runs.
MENDARI_IMAGE=
POSTGRES_PASSWORD=
MENDARI_PUBLIC_URL=https://mendari.example.org

# Sign-in with your identity provider (OpenID Connect)
MENDARI_OIDC_ISSUER=https://login.example.org/realms/clinic
MENDARI_OIDC_CLIENT_ID=mendari
MENDARI_OIDC_CLIENT_SECRET=
MENDARI_OIDC_ROLE_MAP=clinicians=reviewer,informatics=admin,ai-committee=governance

# PHI: inputs encrypted apart from the audit chain, deleted after 90 days; input hashes keyed.
# Two different keys, each 32 random bytes, base64:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MENDARI_PHI_MODE=encrypt
MENDARI_PHI_KEY=
MENDARI_INPUT_HASH_KEY=
MENDARI_RETENTION_DAYS=90

# Your reverse proxy's address as the engine sees it: X-Forwarded-For is trusted only from it,
# and rate limits on sign-in count per client address. A proxy on the host (nginx-limits.conf)
# reaches the engine from the compose network's gateway, 172.30.0.1 (docker-compose.yml fixes
# the subnet), not from 127.0.0.1. Signed in, /api/health's rate_limits.client_ip must be your
# browser's own address, with x_forwarded_for_used: true.
FORWARDED_ALLOW_IPS=172.30.0.1

# The daily jobs' secret (at least 16 random characters: `openssl rand -hex 32`). With it the
# jobs ask the engine for the daily checkpoint, so an audit trail that does not verify reaches
# MENDARI_ALERT_WEBHOOK; without it they run the command themselves, and a failure is only in
# their log and their health (docs/deploying-with-phi.md, section 3).
CRON_SECRET=

# Rate limits are on with sign-in; per-organization daily quotas are off unless set
# (e.g. decisions=5000). See docs/deploying-with-phi.md.
MENDARI_RATE_LIMITS=
MENDARI_ORG_DAILY_LIMITS=
# A daily cap per principal (a person, a key, a client) on the decisions it asks for; off unless set.
MENDARI_PRINCIPAL_DAILY_LIMIT=

# Optional
MENDARI_ALERT_WEBHOOK=
# mendari (JSON, the default) or slack; a secret of 32+ characters signs every alert.
MENDARI_ALERT_FORMAT=
MENDARI_ALERT_SECRET=
MENDARI_FHIR_ALLOWED_SERVERS=
MENDARI_PROVIDERS=
# The only origins Jev, LLM and Vercel Connect requests may reach (comma-separated); unset: no
# such list (docs/deploying-with-phi.md, section 5).
MENDARI_PROVIDER_ALLOWED_ORIGINS=

# Jev, only under an agreement that covers PHI, for agents whose manifests name a Jev variant
# (choose it with MENDARI_PROVIDERS; docs/deploying-with-phi.md, section 5). Their Jev calls
# share the daily budget: size it.
# MENDARI_JEV_DAILY_LIMIT=500
# JEV_API_URL=
# JEV_MODEL=
# JEV_API_KEY=

# The agent registry under this engine, off unless set (docs/operations/registry.md): served at
# /registry/v1/... on this database. Its key (32 random bytes, base64) signs its recalls and
# counter-signs what it lists; the review organization's record is made first
# (mendari access org create).
# MENDARI_REGISTRY=on
# MENDARI_REGISTRY_REVIEW_ORG=registry-review
# MENDARI_REGISTRY_SIGNING_KEY=
