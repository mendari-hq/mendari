{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Written Mini input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message"
  ],
  "properties": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "draft": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
