{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhealth.dev/packs/clinical-trial-prescreener/input.schema.json",
  "title": "Clinical Trial Prescreener input",
  "description": "A patient's record for prescreening: demographics, coded conditions, lab results, medications and clinic notes. Dates are ISO 8601; the screening date defaults to today.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "as_of": {"type": "string", "format": "date", "description": "Screening date"},
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "age": {"type": "integer", "minimum": 0, "maximum": 130},
        "sex": {"type": "string", "enum": ["female", "male", "other", "unknown"]}
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {"type": "string", "description": "ICD-10-CM or SNOMED CT code"},
          "text": {"type": "string"},
          "status": {"type": "string"},
          "onset": {"type": "string"}
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {"type": "string", "description": "LOINC code"},
          "name": {"type": "string"},
          "value": {"type": "number"},
          "unit": {"type": "string"},
          "date": {"type": "string"}
        }
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "description": "RxNorm code"},
          "name": {"type": "string"},
          "status": {"type": "string"},
          "start": {"type": "string"},
          "end": {"type": "string"}
        }
      }
    },
    "notes": {"type": "string", "maxLength": 20000}
  }
}
