{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mendari",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "mendari", "serve", "--port", "8391", "--db", "var/dev.db"],
      "port": 8391
    },
    {
      "name": "mendari-fixtures",
      "runtimeExecutable": "env",
      "runtimeArgs": ["MENDARI_AGENTS_PATH=tests/fixtures/mini-agents", "uv", "run", "mendari", "serve", "--port", "8392", "--db", "var/fixtures.db"],
      "port": 8392
    },
    {
      "name": "registry",
      "runtimeExecutable": "env",
      "runtimeArgs": ["uv", "run", "mendari", "registry", "serve", "--db", "var/registry.db", "--port", "8100"],
      "port": 8100
    },
    {
      "name": "hub-site",
      "runtimeExecutable": "env",
      "runtimeArgs": ["REGISTRY_URL=http://127.0.0.1:8100", "npm", "--prefix", "hub", "run", "dev"],
      "port": 3100
    },
    {
      "name": "web",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3200", "--bind", "127.0.0.1", "--directory", "web"],
      "port": 3200
    }
  ]
}
