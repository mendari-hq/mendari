{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mendari",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "mendari", "serve", "--port", "8391", "--db", "var/dev.db"],
      "port": 8391
    },
    {
      "name": "mendari-fixtures",
      "runtimeExecutable": "env",
      "runtimeArgs": ["MENDARI_PACKS_PATH=tests/fixtures/packs", "uv", "run", "mendari", "serve", "--port", "8392", "--db", "var/fixtures.db"],
      "port": 8392
    },
    {
      "name": "registry",
      "runtimeExecutable": "env",
      "runtimeArgs": ["MENDARI_REGISTRY_ADMIN_TOKEN=local-admin", "uv", "run", "mendari", "registry", "serve", "--db", "var/registry.db", "--port", "8100"],
      "port": 8100
    },
    {
      "name": "hub-site",
      "runtimeExecutable": "env",
      "runtimeArgs": ["REGISTRY_URL=http://127.0.0.1:8100", "npm", "--prefix", "hub", "run", "dev"],
      "port": 3100
    }
  ]
}
