{
  "model": "mock-portal-agent",
  "service_version": "0.1.0",
  "cases": [
    {
      "match": {
        "contains_any": ["chest pain", "chest pressure", "trouble breathing", "drooping", "slurred"],
        "contains_all": ["refill"],
        "exclude_any": ["no chest pain"]
      },
      "response": {
        "answers": {
          "request": {
            "value": "refill",
            "confidence": 0.94,
            "rationale": "Patient requested a medication refill alongside urgent symptoms."
          },
          "urgent_symptoms": {
            "value": "yes",
            "confidence": 0.96,
            "rationale": "Message describes red-flag same-day symptoms requiring nurse review."
          }
        },
        "tool_calls": [
          {"name": "red_flag_screen", "status": "matched"},
          {"name": "intent_classifier", "status": "ok"}
        ]
      }
    },
    {
      "match": {
        "contains_any": ["chest pain", "chest pressure", "trouble breathing", "drooping", "slurred"],
        "exclude_any": ["no chest pain"]
      },
      "response": {
        "answers": {
          "request": {
            "value": "other",
            "confidence": 0.88,
            "rationale": "Urgent symptom report without an administrative queue request."
          },
          "urgent_symptoms": {
            "value": "yes",
            "confidence": 0.97,
            "rationale": "Message describes red-flag same-day symptoms requiring nurse review."
          }
        },
        "tool_calls": [
          {"name": "red_flag_screen", "status": "matched"}
        ]
      }
    },
    {
      "match": {
        "contains_any": ["refill", "ran out", "running low", "renew"]
      },
      "response": {
        "answers": {
          "request": {
            "value": "refill",
            "confidence": 0.95,
            "rationale": "Patient asked to refill or renew an existing prescription."
          },
          "urgent_symptoms": {
            "value": "no",
            "confidence": 0.97,
            "rationale": "No same-day urgent symptoms reported."
          }
        },
        "tool_calls": [
          {"name": "intent_classifier", "status": "ok"}
        ]
      }
    },
    {
      "match": {
        "contains_any": ["appointment", "schedule", "reschedule", "cancel my visit", "book"]
      },
      "response": {
        "answers": {
          "request": {
            "value": "appointment",
            "confidence": 0.94,
            "rationale": "Patient asked to book, reschedule, or cancel a visit."
          },
          "urgent_symptoms": {
            "value": "no",
            "confidence": 0.96,
            "rationale": "No same-day urgent symptoms reported."
          }
        },
        "tool_calls": [
          {"name": "intent_classifier", "status": "ok"}
        ]
      }
    }
  ],
  "default": {
    "answers": {
      "request": {
        "value": "other",
        "confidence": 0.82,
        "rationale": "General clinic inquiry routed to the front desk."
      },
      "urgent_symptoms": {
        "value": "no",
        "confidence": 0.95,
        "rationale": "No same-day urgent symptoms reported."
      }
    },
    "tool_calls": [
      {"name": "intent_classifier", "status": "ok"}
    ]
  }
