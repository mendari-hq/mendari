# Copy to .env and fill in. Never commit the filled-in file. Every setting is explained in
# docs/deploying-with-phi.md.
# A release image (ghcr.io/junebugg1214/openhealth-engine:<tag>, or one pack's image), or one you
# built: docker build --build-arg PACK=openhealth/patient-inbox-router -t openhealth-inbox .
OPENHEALTH_IMAGE=
POSTGRES_PASSWORD=
OPENHEALTH_PUBLIC_URL=https://openhealth.example.org

# Sign-in with your identity provider (OpenID Connect)
OPENHEALTH_OIDC_ISSUER=https://login.example.org/realms/clinic
OPENHEALTH_OIDC_CLIENT_ID=openhealth
OPENHEALTH_OIDC_CLIENT_SECRET=
OPENHEALTH_OIDC_ROLE_MAP=clinicians=reviewer,informatics=admin,ai-committee=governance

# PHI: inputs encrypted apart from the audit chain, deleted after 90 days
OPENHEALTH_PHI_MODE=encrypt
OPENHEALTH_PHI_KEY=
OPENHEALTH_RETENTION_DAYS=90

# Optional
OPENHEALTH_ALERT_WEBHOOK=
OPENHEALTH_FHIR_ALLOWED_SERVERS=
OPENHEALTH_PROVIDERS=
