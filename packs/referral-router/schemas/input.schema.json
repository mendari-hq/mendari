{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhealth.dev/packs/referral-router/input.schema.json",
  "title": "Referral Router input",
  "description": "A specialty referral (its reason and the priority the referrer chose) with the patient's recent documents, reports and laboratory results. Dates are ISO 8601; the as-of date defaults to today.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "as_of": {"type": "string", "format": "date"},
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "age": {"type": "integer", "minimum": 0, "maximum": 130},
        "sex": {"type": "string", "enum": ["female", "male", "other", "unknown"]}
      }
    },
    "referral": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {"type": "string", "maxLength": 5000},
        "priority": {"type": "string", "enum": ["routine", "urgent", "asap", "stat"]}
      }
    },
    "documents": {"$ref": "#/$defs/items", "description": "DocumentReference: code = document type (LOINC)"},
    "reports": {"$ref": "#/$defs/items", "description": "DiagnosticReport: code = report code (LOINC)"},
    "labs": {"$ref": "#/$defs/items", "description": "Laboratory Observation: code = LOINC"}
  },
  "$defs": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string"},
          "name": {"type": "string"},
          "date": {"type": "string"}
        }
      }
    }
  }
}
