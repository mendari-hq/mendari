{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  },
  "crons": [
    { "path": "/api/internal/retention", "schedule": "0 8 * * *" }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,hub/**,docs/**,notes/**,scripts/**,.github/**,tasks/**,web/**}"
    }
  }
}
